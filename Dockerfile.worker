# Always-on worker: FFmpeg renders, Claude drafts, Drive sync and publishing.
# Deploy to Fly.io / Railway / Render (any host that keeps a container running).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg fontconfig ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ENV NODE_ENV=production WORKER_MODE=external
CMD ["pnpm", "worker"]
