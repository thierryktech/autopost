# ─────────────────────────────────────────────────────────────────────────────
# Balena Reel Studio — environment template. Copy to .env.local (web) and set
# the same values on the worker host. NEVER commit real values.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_ variables are used).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the web app (used for OAuth redirect URIs). No trailing slash.
APP_URL=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────────
# Leave empty for local demo mode (embedded PGlite in .data/pglite, single machine).
# For shared data across MacBook + iPad, use a managed Postgres URL (Neon or Supabase).
# Use the *pooled* connection string for the web app and either for the worker.
DATABASE_URL=
# DATABASE_POOL_SIZE=5
# DB_AUTO_MIGRATE=true

# ── Authentication (single private user) ───────────────────────────────────
# 32+ random bytes, e.g.  openssl rand -base64 32
AUTH_SECRET=
# The only Google account allowed to sign in.
ALLOWED_EMAIL=
# Google OAuth client (Web application). Authorised redirect URIs:
#   ${APP_URL}/api/auth/google/callback
#   ${APP_URL}/api/connect/google-drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local development only: skip sign-in (defaults to true when GOOGLE_CLIENT_ID is empty).
# Refused in production unless ALLOW_INSECURE_NO_AUTH=true (don't).
# AUTH_DISABLED=false

# Encrypts OAuth tokens at rest (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Integrations: each starts in demo mode ─────────────────────────────────
# google | demo
DRIVE_ADAPTER=demo
# anthropic | demo
CLAUDE_ADAPTER=demo
# graph | demo
FACEBOOK_ADAPTER=demo
# ffmpeg | simulated  (falls back to simulated automatically if FFmpeg is missing)
RENDER_ADAPTER=ffmpeg

# Claude (Anthropic API — billed separately from a Claude.ai subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Meta app (Facebook Login for Business). Valid OAuth redirect URI:
#   ${APP_URL}/api/connect/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0

# ── Worker ─────────────────────────────────────────────────────────────────
# embedded = job runner inside the web server (local demo only)
# external = separate always-on worker process (`pnpm worker`) — required in production
WORKER_MODE=
WORKER_CONCURRENCY=2
# FFMPEG_PATH=/usr/bin/ffmpeg
# DATA_DIR=.data

# Demo data on first boot of an empty database (true/false)
SEED_DEMO_DATA=true
